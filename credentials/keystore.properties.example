# Copy to credentials/keystore.properties and fill in your own keystore.
# Generate one with:
#   keytool -genkeypair -v -storetype PKCS12 -keystore credentials/quiet-release.jks \
#     -alias quiet -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Quiet, O=Quiet, C=US"
# Paths are relative to the repository root.
storeFile=credentials/quiet-release.jks
storePassword=change-me
keyAlias=quiet
keyPassword=change-me
